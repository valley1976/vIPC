{
  "application": "valley-drive",
  "channel": [{
    "group": "/sensor",
    "subscriber": ["realtime", "recorder"],
    "description": "valley_drive publisher/subscriber/recorder sensor stream",
    "topic": [
      {"name": "/sensor/camera_front", "subscriber": ["realtime", "recorder"],
       "description": "camera 640x480 rgb8 @ 10Hz",
       "ring_size": 64, "data_size": 1048576},
      {"name": "/sensor/camera_near", "subscriber": ["realtime", "recorder"],
       "description": "camera 640x480 rgb8 @ 10Hz",
       "ring_size": 64, "data_size": 1048576},
      {"name": "/sensor/camera_left", "subscriber": ["realtime", "recorder"],
       "description": "camera 640x480 rgb8 @ 10Hz",
       "ring_size": 64, "data_size": 1048576},
      {"name": "/sensor/camera_right", "subscriber": ["realtime", "recorder"],
       "description": "camera 640x480 rgb8 @ 10Hz",
       "ring_size": 64, "data_size": 1048576},
      {"name": "/sensor/imu", "subscriber": ["realtime", "recorder"],
       "description": "IMU @ 100Hz",
       "ring_size": 1024, "data_size": 4096},
      {"name": "/sensor/lidar", "subscriber": ["realtime", "recorder"],
       "description": "LaserScan with ranges/intensities @ 10Hz",
       "ring_size": 256, "data_size": 65536}
    ]
  }],
  "shared": [
    {"name": "param", "size": "512B"}
  ],
  "notification": [
    {"name": "FAULT", "event": ["安全带未系", "相机被遮挡"]}
  ]
}
